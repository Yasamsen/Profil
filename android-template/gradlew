#!/usr/bin/env sh
# Small bootstrap wrapper: downloads Gradle distribution on first run.
set -eu
VERSION="8.7"
BASE="${GRADLE_USER_HOME:-$HOME/.gradle}/web2apk-wrapper"
DIST="$BASE/gradle-$VERSION"
if [ ! -x "$DIST/bin/gradle" ]; then
  mkdir -p "$BASE"
  ARCHIVE="$BASE/gradle-$VERSION-bin.zip"
  if command -v curl >/dev/null 2>&1; then curl -fsSL "https://services.gradle.org/distributions/gradle-$VERSION-bin.zip" -o "$ARCHIVE"
  else wget -q "https://services.gradle.org/distributions/gradle-$VERSION-bin.zip" -O "$ARCHIVE"; fi
  unzip -q -o "$ARCHIVE" -d "$BASE"
fi
exec "$DIST/bin/gradle" "$@"
